{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Synthetic benchmark sidecar only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/reportmaker-bench-bridge",
          "sidecar": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
